# Local development environment
# Vite proxies /api/* -> http://localhost:8001 (see vite.config.js)
# Do NOT set VITE_API_URL here — leave it unset so getApiBase() returns '/api'
# and the Vite proxy handles the forwarding.
#
# Only set VITE_API_URL when deploying to Render/production, e.g.:
#   VITE_API_URL=https://your-backend.onrender.com

# (no variables needed — Vite proxy handles everything locally)
